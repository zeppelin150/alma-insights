{
  "patterns": [
    {"name": "ssn", "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "replace": "[SSN]"},
    {"name": "email", "regex": "[\\w.+-]+@[\\w-]+\\.[\\w.-]+", "replace": "[EMAIL]"},
    {"name": "phone", "regex": "\\b\\d{3}[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b", "replace": "[PHONE]"},
    {"name": "credit_card", "regex": "\\b\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}[-\\s]?\\d{4}\\b", "replace": "[CARD]"},
    {"name": "mrn", "regex": "\\bMRN[-#:]?\\s?\\d{4,10}\\b", "replace": "[MEMBER_ID]", "flags": "i"},
    {"name": "member_id", "regex": "\\b(?:MBR|MEM|MEMBER(?:\\s?ID)?|ACCT)[-#:\\s]{0,2}\\d{4,10}\\b", "replace": "[MEMBER_ID]", "flags": "i"},
    {"name": "dob", "regex": "\\b\\d{1,2}[-/]\\d{1,2}[-/]\\d{4}\\b", "replace": "[DOB]"},
    {"name": "url", "regex": "https?://[^\\s]+", "replace": "[URL]"},
    {"name": "address", "regex": "\\b\\d{1,5}\\s+[A-Z][a-zA-Z]+(?:\\s+[A-Z][a-zA-Z]+)*\\s+(?:St|Ave|Blvd|Dr|Rd|Ln|Ct|Way|Pl|Cir)\\.?\\b", "replace": "[ADDRESS]"},
    {"name": "name_heuristic", "regex": "\\b([A-Z][a-z]+)\\s+([A-Z][a-z]+)\\b", "replace": "[NAME]", "flags": "g", "conditional": true}
  ],
  "aggressive_skip_terms": [
    "Claim", "Denial", "Prior", "Auth", "Authorization", "Billing",
    "Payment", "Posting", "Timely", "Filing", "Coordination",
    "Benefits", "Eligibility", "Verification", "Provider",
    "Enrollment", "Credentialing", "Resubmission", "Appeal",
    "Refund", "Credit", "Cancel", "Cancellation", "Session",
    "Insurance", "Coverage", "Modifier", "Code", "TRC"
  ]
}
