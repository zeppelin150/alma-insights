# ─────────────────────────────────────────────────────────────────────
# Alma Insights — .gitignore
# ─────────────────────────────────────────────────────────────────────
# Policy: user data, local caches, machine-specific state, and
# Claude Code's local files are NEVER committed. Anything generated at
# runtime or build time lives here.
# ─────────────────────────────────────────────────────────────────────

# ── Claude Code local state (NEVER commit) ──────────────────────────
.claude/
.claude/**
.claude/worktrees/
**/.claude/
# Claude Code MCP server config
.mcp.json
# Session-state docs that reference local Claude plan/memory paths
NEXT_SESSION_KERNEL.md
DESTRUCTIVE_IMPORT_KERNEL.md

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.spec
.pytest_cache/
.lockenv/
.venv/
venv/
env/

# ── Build + distribution ────────────────────────────────────────────
dist/
build/
installer/cache/
*.egg

# ── Runtime data (all of data/ is machine-local) ────────────────────
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ── Auto-update artefacts (Phase 3 + Phase 5) ───────────────────────
_update_staging/
_src_backup/
_config_backup/
_migrations_backup/
_src_previous/
_config_previous/
_migrations_previous/
_src_rollback_tmp/
_config_rollback_tmp/
_migrations_rollback_tmp/

# Build-injected release credentials. Generated by
# installer/build_release.py from a CI secret. Holds the obfuscated
# GitHub PAT used for auto-update polling. NEVER commit.
src/updater/_release_credentials.py

# Build-injected Google OAuth desktop client (obfuscated client_id/secret).
# Generated by installer/build_release.py from ALMA_GOOGLE_OAUTH_CLIENT.
# NEVER commit.
src/data/_google_oauth_client.py

# ── Archived dead code + scratch ────────────────────────────────────
_archive/
_check_db.py
ocr_debug/
debug/

# ── Environment + secrets ───────────────────────────────────────────
.env
.env.*
*credentials*.json
*token*.json
*secret*
*.yaml.migrated
# Google OAuth client configs under their natural names (gcloud/quickstart
# defaults + plausible operator names) — keep a real client_secret out of git.
*oauth*client*.json
*client*secret*.json
gcp-oauth*.json
gcp_oauth*.json
google_client*.json
oauth_client*.json

# Re-include the secrets-audit tool + its test (their filenames match
# *secret* but they hold no secrets — they're the tool that FINDS them).
!scripts/audit_secrets.py
!tests/test_audit_secrets.py

# ── IDE + editor ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
nul
NUL

# ── Logs + test output ──────────────────────────────────────────────
*.log
analysis_log.jsonl
/test_err.txt
/test_final.txt
/test_out.txt
/test_result.txt
/test_results.txt
/test_results_phase1.txt
/test_run.txt
/test_run2.txt

# ── Mangled Windows-path filename leftovers ─────────────────────────
C:alma-insights*
C:\alma-insights*

# ── Ad-hoc test screenshots + dev scripts at root ───────────────────
/test_calendar.png
/test_calendar_card.png
/test_calendar_grab.py
/test_calendar_grab_*.png
/test_calendar_visual.py
/test_calendar_visual.png
/test_full_system.py
/test_session_*.py

# ── Dev maintenance artefacts ───────────────────────────────────────
/line_counts.txt
/file_manifest.txt
/feature-manifest.json

# ── Local-only audit/regression tests (never committed) ─────────────
# Pin local fixes from audit passes without committing the scaffolding.
tests/test_*_local.py

# ── Exports ─────────────────────────────────────────────────────────
exports/
*.pdf

# ── Node.js (scan_server) ───────────────────────────────────────────
node_modules/
scan_server/node_modules/

# ── Agent web UI (React/Vite) — generated bundle + deps ─────────────
web/node_modules/
src/ui/web/dist/
npm-debug.log
yarn-debug.log
yarn-error.log
package-lock.json

# ── HuggingFace cache (local dev downloads) ─────────────────────────
.cache/huggingface/
~/.cache/huggingface/

# ── E2E runner output artifacts ─────────────────────────────────────
# Per-run JSON + markdown dumps from scripts/run_ai_report_e2e.py.
# Useful for local inspection but should never be committed.
tools/audit_reports/e2e_*.json
tools/audit_reports/e2e_*.md
